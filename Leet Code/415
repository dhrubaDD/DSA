class Solution {
public:
    string addStrings(string num1, string num2) {
        int i=num1.size()-1;
        int j=num2.size()-1;
        int carry=0;
        string ans;
        int sum;
        while(i>=0 && j>=0){
            int a=(int)(num1[i]-'0');
            int b=(int)(num2[j]-'0');

            sum=(a+b+carry)%10;
            carry=(a+b+carry)/10;
            ans.push_back('0'+sum);
            i--;
            j--;
        }
        while(i>=0){
            int a=(int)(num1[i]-'0');
            sum = (a+carry)%10;
            carry=(a+carry)/10;
            ans.push_back('0'+sum);
            i--;
        }
        while(j>=0){
            int a=(int)(num2[j]-'0');
            sum = (a+carry)%10;
            carry=(a+carry)/10;
            ans.push_back('0'+sum);
            j--;
        }
        if(carry>0) ans.push_back('0'+carry);
        reverse(ans.begin(), ans.end());
        return ans;
    }
};
