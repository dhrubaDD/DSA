class Solution {
public:
#include<cctype>
    bool isPalindrome(string s) {
        string str=s;
        for(int i=0;i<s.length();i++){
            str[i]=tolower((unsigned char)s[i]);
        }
        str.erase(remove_if(str.begin(),str.end(),[](unsigned char c){
            return !isalnum(c);
        }),str.end());

        string pal=str;
        reverse(str.begin(),str.end());
        if(pal==str) return true;
        else return false;
    }
};
